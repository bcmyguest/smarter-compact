{
  "description": "Smarter Compact: tell the session that trimmed turns are searchable, and record a compact request.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/smarter-compact-hook\"", "timeout": 30 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/smarter-compact-hook\"", "timeout": 10 }] }]
  }
}
