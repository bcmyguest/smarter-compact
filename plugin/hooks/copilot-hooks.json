{
  "description": "Smart Compact on the GitHub Copilot CLI.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/scripts/smart-compact-hook\" --host copilot", "timeout": 10 }] }],
