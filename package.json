{
  "name": "smarter-compact",
  "version": "0.6.0",
  "description": "Context management (smart compaction) for coding agents: keep long sessions under a token limit without an LLM summary. Every message goes into a local SQLite session store; older turns leave the context and the agent searches the store when it needs a detail back.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "B Guest",
  "homepage": "https://github.com/bcmyguest/smarter-compact#readme",
  "bugs": {
    "url": "https://github.com/bcmyguest/smarter-compact/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcmyguest/smarter-compact.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context-management",
    "smarter-compaction",
    "smarter-compact"
  ],
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "bin": {
    "smarter-compact": "plugin/scripts/smarter-compact.mjs"
  },
  "files": [
    "index.mjs",
    "src/**/*.mjs",
    "plugin/lib/**/*.mjs",
    "plugin/scripts/smarter-compact",
    "plugin/scripts/smarter-compact.mjs",
    "plugin/scripts/smarter-compact-hook",
    "plugin/scripts/smarter-compact-hook.mjs",
    "plugin/scripts/smarter-compact-mcp",
    ".claude-plugin/marketplace.json",
    "plugin/.claude-plugin/plugin.json",
    "plugin/.codex-plugin/plugin.json",
    "plugin/.mcp.json",
    "plugin/hooks/hooks.json",
    "plugin/hooks/codex-hooks.json",
    "plugin/slash-commands/*.md",
    "plugin/codex-skills/**",
    "plugin/pi/smarter-compact.js",
    "plugin/lib/mcp/**/*.mjs",
    "proxy/smarter_compact/**/*.py",
    "proxy/smarter_compact_hook.py",
    "proxy/config.yaml",
    "docs/_config.yml",
    "docs/index.md",
    "docs/context-management.md",
    "docs/context-proxy.md",
    "docs/context-store.md",
    "docs/opencode.md",
    "docs/media/**",
    "!docs/media/*.mp4",
    "!docs/media/*-poster.png",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24",
    "opencode": ">=1.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./plugin/pi/smarter-compact.js"
    ]
  },
  "scripts": {
    "test": "node --test tests/plugin.test.mjs tests/opencode-export.test.mjs tests/proxy-daemon.test.mjs tests/litellm.test.mjs tests/context-config.test.mjs tests/recall-mcp.test.mjs tests/context-trim.test.mjs tests/session-db.test.mjs tests/config-wiring.test.mjs tests/scratchpad.test.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "version": "node scripts/sync-versions.mjs"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@renovatebot/pep440": "^6.0.0"
  }
}
