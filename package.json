{
  "name": "smarter-compact",
  "version": "0.2.0",
  "description": "Smart compaction for coding agents: trim context without a summary; older turns stay in a local store the agent can search.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "B Guest",
  "homepage": "https://github.com/bcmyguest/smarter-compact#readme",
  "bugs": {
    "url": "https://github.com/bcmyguest/smarter-compact/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcmyguest/smarter-compact.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context-management",
    "smarter-compaction",
    "smarter-compact"
  ],
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "bin": {
    "sc": "plugin/scripts/smarter-compact.mjs",
    "smarter-compact": "plugin/scripts/smarter-compact.mjs"
  },
  "files": [
    "index.mjs",
    "src/**/*.mjs",
    "plugin/lib/**/*.mjs",
    "plugin/scripts/sc",
    "plugin/scripts/smarter-compact",
    "plugin/scripts/smarter-compact.mjs",
    "plugin/scripts/smarter-compact-hook",
    "plugin/scripts/smarter-compact-hook.mjs",
    "plugin/scripts/smarter-compact-mcp",
    "plugin/lib/mcp/**/*.mjs",
    "proxy/openmem_context/**/*.py",
    "proxy/openmem_context_hook.py",
    "proxy/config.yaml",
    "docs/context-store.md",
    "docs/opencode.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.16",
    "opencode": ">=1.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./plugin/pi/smarter-compact.js"
    ]
  },
  "scripts": {
    "test": "node --test tests/plugin.test.mjs tests/opencode-export.test.mjs",
    "pack:check": "node scripts/check-pack.mjs"
  }
}
